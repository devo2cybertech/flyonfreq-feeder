# Copy to /etc/ffq-push.env (owner root, mode 600). The install script does this for you.
# NEVER commit a real key. The key is secret: it identifies your receiver.
FFQ_URL=https://api.flyonfreq.com/api/tracking/receiver/push
FFQ_KEY=paste-your-key-here
# Where your receiver writes its aircraft list (readsb: /run/readsb/aircraft.json, dump1090-fa: /run/dump1090-fa/aircraft.json)
FFQ_SOURCE=/run/readsb/aircraft.json
# Seconds between sends (default 2)
#FFQ_EVERY=2
